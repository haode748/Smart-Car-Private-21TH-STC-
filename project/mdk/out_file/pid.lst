  114          //增量式PID
  115          int32 IncrementalPID_Calculate(RS_Incremental_PID *pid , int32 wheel_ex )
  116          { 
  117   1        pid->Err = wheel_ex - (int32)pid->Measure;          // 误差 = 目标 - 实际
  118   1        
  119   1        //增量
  120   1        
  121   1        pid->p_out = pid->Kp * (pid->Err - pid->Last_Err);
  122   1        pid->i_out = pid->Ki * pid->Err;
C251 COMPILER V5.60.0,  pid                                                                10/11/26  16:54:46  PAGE 3   

  123   1        pid->d_out = pid->Kd * (pid->Err - 2*pid->Last_Err + pid->Previous_Err);
  124   1        
  125   1        pid->Output += pid->p_out + pid->i_out + pid->d_out;    // ★ 累加
  126   1        
  127   1        pid->Previous_Err = pid->Last_Err;
  128   1        pid->Last_Err =  pid->Err;
  129   1        
  130   1        pid->Output = Clip(pid->Output,-7000 , 7000); // 限幅保护编码器和电机，同时避免超调
  131   1        return pid->Output;
  132   1      }
